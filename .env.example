# LiveKit Cloud project (free "Build" plan is enough, no card).
# Easiest way to fill these: `lk cloud auth` then `lk app env -w` (writes .env.local),
# or copy them from cloud.livekit.io -> Settings -> API keys.
# One credential covers STT, LLM and TTS through LiveKit Inference.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
